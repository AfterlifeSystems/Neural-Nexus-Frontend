# Copy to .env (or .env.development) and fill in the values.
# Every variable read through import.meta.env must be listed here without a value.

# Neural Nexus API
VITE_NEURAL_NEXUS_API_BASE_URL=

# Hosted billing / checkout portal
# Defaults to https://checkout.neuralnexus.site when unset.
VITE_BILLING_PORTAL_URL=

# Public demo avatar embedded on the landing page
VITE_DEMO_SHARE_BASE_URL=
VITE_DEMO_ASSISTANT_ID=

# Public Evan help avatar (sidebar "?" overlay). When unset, the demo avatar
# is used — the same publicly shared assistant that assists people in Neural Nexus.
VITE_EVAN_ASSISTANT_ID=

# Administrator account. This account may share any avatar, including avatars it
# did not create and avatars that do not depict their creator. Must name the same
# account as the API's ADMIN_USER_ID. Defaults to e.woods.business@icloud.com.
VITE_ADMIN_ACCOUNT_EMAIL=

# LangSmith Threads view opened from a message while Vite is in development and
# the signed-in account is the administrator. Defaults match the Neural Nexus
# tracing project. Production builds never show the link.
VITE_LANGSMITH_ORG_ID=
VITE_LANGSMITH_PROJECT_ID=

# Ambient vision. While the webcam or the screen is shared, one snapshot per
# source is sent to the avatar every this-many seconds as background context
# (default 5). Sharing starts the looks; stopping the share ends them. There
# is no separate control. The API enforces its own minimum interval.
VITE_AMBIENT_CAPTURE_INTERVAL_SECONDS=

# Who is speaking. Whether live voice mode on a personal avatar starts with
# speaker-labelled turns (the owner recognised by voice, other people in the
# room as Speaker N) before the person toggles it. Default true.
VITE_VOICE_SPEAKER_LABELS_DEFAULT=

# Geo-located avatars. The local map (the sidebar panel and the pin picker)
# draws raster tiles from a tile server; the world globe draws its own imagery
# and needs none. The default is the OpenStreetMap standard layer, whose usage
# policy asks that a production deployment point this at its own tile server or
# a commercial provider. VITE_GEOCODER_URL is the search endpoint the pin
# picker asks when someone types a place name (default the public Nominatim
# instance, which allows one request per second; point this at your own
# Nominatim or a provider with the same /search?q=&format=jsonv2 shape).
# VITE_GEO_CHECKIN_INTERVAL_SECONDS is the floor between two position reports
# while the nearby-avatar watch is on (default 60).
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
VITE_GEOCODER_URL=
VITE_GEO_CHECKIN_INTERVAL_SECONDS=

# Usage analytics. While an account that opted in is signed in, the browser
# captures this page (rendered from the document; no window picker) once
# every this-many seconds while the tab is visible, and once after each route
# change (default 30, floor 10). The API enforces its own minimum interval.
VITE_USAGE_ANALYTICS_CAPTURE_INTERVAL_SECONDS=

# Misc
VITE_TESTING=

# --- Motion wireframe (how the person moves) — src/services/motionWireframe.js ---
# Landmark the person over a live webcam and send windows on the ambient observation.
VITE_MOTION_WIREFRAME_ENABLED=
# Draw the landmark points over the sidebar camera preview.
VITE_MOTION_WIREFRAME_OVERLAY=
VITE_MOTION_FACE_FPS=
VITE_MOTION_BODY_FPS=
VITE_MOTION_TRACK_WINDOW_SECONDS=
VITE_MOTION_TRACK_MAX_BYTES=
VITE_MOTION_TASKS_VISION_WASM_URL=
VITE_MOTION_POSE_MODEL_URL=
VITE_MOTION_FACE_MODEL_URL=
