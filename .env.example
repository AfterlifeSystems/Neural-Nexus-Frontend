# Copy to .env (or .env.development) and fill in the values.
# Every variable read through import.meta.env must be listed here without a value.

# Neural Nexus API
VITE_NEURAL_NEXUS_API_BASE_URL=

# Hosted billing / checkout portal
# Defaults to https://checkout.neuralnexus.site when unset.
VITE_BILLING_PORTAL_URL=

# Public demo avatar embedded on the landing page
VITE_STREAMLIT_EMBED_URL=
VITE_DEMO_ASSISTANT_ID=

# Misc
VITE_TESTING=
