// storage.rules
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // User can fully manage everything under their own users/{userId} folder
    match /users/{userId}/{allPaths=**} {
      allow read, write, delete: 
        if request.auth != null && request.auth.uid == userId;
    }

    // Optional: completely deny everything else
    match /{allPaths=**} {
      allow read, write, delete: if false;
    }
  }
}